{
  "name": "dedsi-arche-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": "^22.13.0 || >=24.0.0" },
  "scripts": {
    "dev": "vite --mode development",
    "dev:prototype": "vite --mode prototype",
    "dev:test": "vite --mode test",
    "dev:prod": "vite --mode production",
    "build": "tsc -b && vite build --mode production",
